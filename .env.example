# ---------------------------------------------------------------------------
# Autenticación del panel (único usuario: el dueño)
# ---------------------------------------------------------------------------
OWNER_EMAIL=joelsanchezworks@gmail.com
OWNER_PASSWORD=cambia_esta_contraseña

# Secreto para firmar la sesión (NextAuth). Genera uno con:
#   openssl rand -base64 32
NEXTAUTH_SECRET=
# URL pública de la app (en local usa http://localhost:3000)
NEXTAUTH_URL=https://extractos-bancarios.vercel.app

# ---------------------------------------------------------------------------
# Anthropic Claude
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
# Modelo a usar. El modelo original del proyecto (claude-3-5-sonnet-20241022)
# fue retirado; usamos el Sonnet actual, ideal para clasificación.
ANTHROPIC_MODEL=claude-sonnet-5

# ---------------------------------------------------------------------------
# Google (Service Account con acceso a Sheets y Drive)
# ---------------------------------------------------------------------------
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Clave privada del service account. Mantén los \n literales (una sola línea).
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Un único Google Sheet NATIVO con TODO: pestañas por comunidad, la plantilla
# "48 ESC" y las pestañas internas (_Procesados, Pendiente Revision,
# _Comunidades). No uses un .xls subido a Drive.
GOOGLE_SHEETS_ID_CLIENTE=1LbZLL3w3TPPQyi34l8sK0byoyWS1W4_al00pfJ1M4a0
GOOGLE_DRIVE_FOLDER_ID=1A3LX320kw8kxbcjnznMVY_MPgMUKLTWz

# ---------------------------------------------------------------------------
# Avisos por email (opcional). Si no se configura, se omite el envío.
# Ejemplo con Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, contraseña de app.
# ---------------------------------------------------------------------------
SUPERVISOR_EMAIL=joelsanchezworks@gmail.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ---------------------------------------------------------------------------
# Webhook de Google Drive (opcional)
# Si defines WEBHOOK_SECRET, el endpoint /api/webhook exigirá el token
# en la cabecera x-webhook-token o en el parámetro ?token=
# ---------------------------------------------------------------------------
WEBHOOK_SECRET=
